# Firebase web config — copy values from Firebase Console → Project Settings → Your apps → Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs
# Web client ID: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 → Web client
# iOS client ID: GoogleService-Info.plist → CLIENT_ID field
# Android client ID: google-services.json → oauth_client[client_type==3].client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# API base URL (no trailing slash)
# Dev: set to your machine's local IP, e.g. http://192.168.1.100:8000
# Prod: your Railway API URL, e.g. https://api.tasksareus.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth redirect URI note:
# Expo Go (dev): add exp://[your-local-ip]:8081 to authorized redirect URIs in Google Cloud Console
# Standalone build: add tasksareus:// to authorized redirect URIs
